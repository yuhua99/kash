# Vite Dev Server
# Comma-separated list of allowed hostnames (e.g. myapp.example.com,other.example.com)
# ALLOWED_HOSTS=

# API Configuration
# Browser-side API base URL (used by client-side fetch in the browser)
VITE_API_BASE_URL=http://localhost:3000

# Server-side API base URL (used by SvelteKit Node process in hooks.server.ts)
# Only needed when VITE_API_BASE_URL is a relative path (e.g. /api via nginx proxy),
# because server-side fetch requires an absolute URL.
# SERVER_API_BASE_URL=http://localhost:3000
